# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# On Render, set these in the dashboard → your service → Environment.

# --- Required ---
# Neon.tech → your project → Connection Details → "Connection string" (pooled is fine)
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
GEMINI_API_KEY=

# --- Daily summary email via Gmail ---
# GMAIL_PASS is a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal Gmail password. Leave both blank to log emails to the console instead.
GMAIL_USER=
GMAIL_PASS=

# Render injects PORT automatically (10000); locally the app falls back to 3000 if unset.
PORT=10000

# --- Optional ---
APP_TZ=Asia/Kolkata
# Long random string; REQUIRED on Render or users are signed out on every restart.
SESSION_SECRET=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
# PG_POOL_MAX=5                 # Neon free tier has a small connection budget
# PGSSLMODE=disable             # only for a local Postgres without TLS (localhost is auto-detected)

# Firebase Google sign-in — leave blank to use demo sign-in.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# ALLOW_DEMO_LOGIN=false        # defaults to true only when Firebase is not configured

# Generic SMTP (used only if GMAIL_USER/GMAIL_PASS are blank)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NutriPath <no-reply@example.com>
# DAILY_EMAIL_CRON=0 8 * * *
